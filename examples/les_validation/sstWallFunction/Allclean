#!/usr/bin/env bash
case_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source /opt/openfoam10/etc/bashrc
set -euo pipefail
cd "${case_dir}"

initial_time="$(foamDictionary system/controlDict -entry startTime -value | tr -d '[:space:]')"
for time_dir in [0-9]*; do
    [[ -d "${time_dir}" ]] || continue
    [[ "${time_dir}" == "${initial_time}" ]] && continue
    [[ "${time_dir}" =~ ^[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$ ]] || continue
    rm -rf -- "${time_dir}"
done
rm -rf -- constant/polyMesh
rm -f -- log.blockMesh log.solver runtime.solver check_wall_function_gpu.json \
    check_wall_function_restart.json
