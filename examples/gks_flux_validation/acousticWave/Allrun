#!/usr/bin/env bash
case_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)/scripts/openfoam10-env.sh"
set -euo pipefail
"${case_root}/Allclean"
for cells in 50 100 200; do
    child="${case_root}/N${cells}"
    python3 "${case_root}/prepare_fields.py" "${child}" "${cells}"
    blockMesh -case "${child}" > "${child}/log.blockMesh" 2>&1
    (
        cd "${child}"
        /usr/bin/time -f 'elapsed_seconds=%e' -o runtime.solver \
            GpuGkp > log.solver 2>&1
    )
done
PYTHONDONTWRITEBYTECODE=1 python3 "${case_root}/check_convergence.py"
PYTHONDONTWRITEBYTECODE=1 python3 "${case_root}/postprocess.py"
