#!/usr/bin/env bash

set -euo pipefail

suite_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
events="${suite_dir}/RUN_EVENTS.dense_e1.tsv"

if [[ -e "${events}" ]]; then
    echo "ERROR: refusing to overwrite ${events}" >&2
    exit 1
fi

printf 'timestamp\tcase\tevent\n' > "${events}"
printf '%s\t%s\t%s\n' "$(date --iso-8601=seconds)" "dense/e1" start >> "${events}"
"${suite_dir}/dense/e1/Allrun"
printf '%s\t%s\t%s\n' "$(date --iso-8601=seconds)" "dense/e1" complete >> "${events}"
touch "${suite_dir}/DENSE_E1_COMPLETE"
