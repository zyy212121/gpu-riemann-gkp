FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    "(p|U|rho|T|Tglobal|phiLS|h|he).*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-12;
        relTol          0;
    }
}

GPU2_8
{
    rhoMin              1e-12;
    TMin                1;
    robustFallback      true;
    maxDiffusionNumber  0.25;
}

relaxationFactors
{
}
