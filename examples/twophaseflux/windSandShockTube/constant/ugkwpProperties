FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      ugkwpProperties;
}

gpuResidentStrict true;
gpuResidentPureGasOnly false;
gpuResidentDynamicInlet false;
gpuResidentParticleCapacity 220000;
gpuResidentRandomSeed 24681357;
gpuResidentMaxFaceWalkHops 32;
gpuResidentCourantUpdateInterval 100;
gpuResidentMaxDeltaTGrowth 1.0;

// Explicit sealed GPU2.8 L1 particle path.  E1/E2 are validation variants,
// not defaults for these physical reference cases.
gpuCsrCellLocalPath true;
gpuCsrHeavyReduction false;
gpuCsrHeavyCellThreshold 4096;
gpuCsrHeavyTileParticles 4096;
gpuCsrHeavyWorkerBlocksPerSM 4;
gpuCsrWarpAggregatedBinning false;

rhoS 1000;
dS 1;
dMin 1;
dMax 1;
dSigma 0;
parcelMass 2.5000000000000002e-06;

gpuResidentDragModel constantResponseTime;
gpuResidentParticleResponseTime 0.20000000000000001;
gpuResidentHeatTransferModel constantResponseTime;
gpuResidentParticleThermalResponseTime 0.10000000000000001;
gpuResidentGasHeatCapacity 0.20000000000000001;


gpuResidentCollisionalPressure false;
gpuResidentCollisionalRestitution 1.0;
gpuResidentPressureKickFraction 0.25;
gpuResidentJammingPressure false;
gpuResidentPackingProjectionIterations 20;
epsSMin 1e-14;
thetaMin 0;
TgasMin 1e-8;
gpuResidentInjectionTheta 0;
gpuResidentInjectionTp 1;

particleWallCoeffs
{
    default 1.0;
}
