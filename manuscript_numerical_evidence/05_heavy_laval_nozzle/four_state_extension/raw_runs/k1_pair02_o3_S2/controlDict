FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     GpuGkp;

startFrom       startTime;

startTime       0.11500001;

stopAt          endTime;

endTime         0.11501001;

deltaT          4.9999999999999998e-08;

writeControl    timeStep;

writeInterval   1000000000;

purgeWrite      0;

writeFormat     ascii;

writePrecision  14;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  no;

maxCo           0.5;

maxDeltaT       0.0001;


