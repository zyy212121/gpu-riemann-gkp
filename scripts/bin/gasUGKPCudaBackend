#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
exe="${root}/build/bin/gasUGKPCudaBackend"
if [[ ! -x "$exe" ]]; then
    printf 'Local executable missing: %s. Run this package Allwmake first.\n' "$exe" >&2
    exit 127
fi
export GAS_UGKP_CUDA_BACKEND="${root}/build/bin/gasUGKPCudaBackend"
exec "$exe" "$@"
